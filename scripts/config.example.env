# Copy to scripts/.env and fill in (or export in your shell)
GCP_PROJECT_ID=your-project-id
GCS_BUCKET=your-bucket-name
# Path to service account JSON (download from GCP Console > IAM > Service Accounts)
GOOGLE_APPLICATION_CREDENTIALS=../service-account.json
# bn-BD (Bangladesh) or bn-IN (India)
TTS_LANGUAGE_CODE=bn-IN
TTS_VOICE_NAME=bn-IN-Wavenet-A
TRANSLATE_TARGET=bn
